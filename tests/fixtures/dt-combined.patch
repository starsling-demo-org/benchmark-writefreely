index 00000000..a00900e5
--- /dev/null
+++ b/scripts/narrow-workspace.sh
@@ -0,0 +1,34 @@
+#!/bin/bash
+# Narrow pnpm-workspace.yaml for a filtered install. Every pnpm call in scripts/pnpm-install.sh (install, ls, install, ls) first reads all
+# ~9k workspace package.json files (~1.6 s each). Narrow pnpm-workspace.yaml for the install to a NAME-closure
+# that contains every project pnpm can select or link: projects with changed files, their dependents (by
+# name, transitive), then every dependency name's dirs (all versions), transitive. It stays narrowed through test-all.
+set -euo pipefail
+if git diff --name-only HEAD^1 | grep -q -E 'types/(react|prop-types|scheduler)/' \
+   || git diff --diff-filter=DR --name-only HEAD^1 | grep -q 'package.json'; then
+  echo "full install for this diff: workspace left as is"; exit 0
+fi
+t=$(mktemp -d)
+git diff --name-only HEAD^1 -- types/ > "$t/changed"
+git ls-files -z -- ':(glob)types/**/package.json' | xargs -0 jq -c '{dir: (input_filename | sub("/package.json$"; "")), name: (.name // ""), deps: ([.dependencies, .devDependencies, .peerDependencies, .optionalDependencies] | map(select(type == "object") | to_entries[] | .key, ((.value | tostring | capture("^npm:(?<n>@?[^@]+)") | .n) // empty)) | unique)}' > "$t/projects"
+jq -rs --rawfile changed "$t/changed" '
+  (map({key: .dir, value: .}) | from_entries) as $by
+  | (reduce .[] as $p ({}; .[$p.name] += [$p.dir])) as $named
+  | (reduce .[] as $p ({}; reduce ($p.deps[] | select(. != $p.name)) as $d (.; .[$d] += [$p.dir]))) as $rev
+  | def grow(f): {sel: ., front: .} | until((.front | length) == 0 or (.sel | length) > 400;
+        .sel as $sel | ([ .front[] | f ] | unique | map(select(. as $d | ($sel | index($d)) == null))) as $new
+        | {sel: ($sel + $new), front: $new}) | .sel;
+  [ $changed | split("\n")[] | select(length > 0) | split("/") as $s
+    | [ range(2; $s | length) | $s[0:.] | join("/") | select($by[.] != null) ] | last // empty ] | unique
+  | grow($by[.].name as $n | ($rev[$n] // [])[], ($named[$n] // [])[])
+  | grow($by[.].deps[] | ($named[.] // [])[])
+  | sort[] ' "$t/projects" > "$t/dirs"
+n=$(wc -l < "$t/dirs")
+echo "name-closure: $n workspace project(s)"; sed 's/^/  /' "$t/dirs"
+if [ "$n" -eq 0 ] || [ "$n" -gt 400 ]; then echo "closure empty or > 400: workspace left as is"; rm -rf "$t"; exit 0; fi
+{ echo "packages:"; echo "  - 'scripts'"; sed "s/^\(.*\)$/  - '\1'/" "$t/dirs"; awk '/^packages:/{p=1;next} p && /^  - /{next} {p=0; print}' pnpm-workspace.yaml; } > "$t/ws"
+cat "$t/ws" > pnpm-workspace.yaml; rm -rf "$t"
+# keep the narrowed file out of the `git diff HEAD^1` change detection of pnpm filters
+git update-index --assume-unchanged pnpm-workspace.yaml
+head -n "$((n + 3))" pnpm-workspace.yaml
+
