diff --git a/scripts/pnpm-install.sh b/scripts/pnpm-install.sh
index 2c60e618..5a6cd775 100755
--- a/scripts/pnpm-install.sh
+++ b/scripts/pnpm-install.sh
@@ -12,6 +12,14 @@ if git diff --diff-filter=DR --name-only HEAD^1 | grep -q 'package.json'; then
     exit 0
 fi
 
+# Every pnpm call below (and dtslint-runner's two `pnpm ls -r` in test-all) first reads all ~9k workspace package.json
+# files. Install from a workspace narrowed to the diff's name-closure (a superset of every project these filters, and
+# test-all's `...@types/**[HEAD^1]`, can select or link). It stays narrowed for the rest of the CI job (the file is
+# marked assume-unchanged, so git diff HEAD^1 does not see it); the full-install fallbacks restore it first.
+cp pnpm-workspace.yaml "${RUNNER_TEMP:-/tmp}/pnpm-workspace.yaml.orig"
+restore_ws() { cat "${RUNNER_TEMP:-/tmp}/pnpm-workspace.yaml.orig" > pnpm-workspace.yaml; git update-index --no-assume-unchanged pnpm-workspace.yaml; }
+./scripts/narrow-workspace.sh
+
 # Workaround for https://github.com/pnpm/pnpm/issues/7283
 # After installing everything the first time, reread the graph and see if anything was missing..
 # If something was missing, we install that again and repeat until nothing is missing.
@@ -33,6 +41,7 @@ while true; do
     if [ $CODE -ne 0 ]; then
         echo "pnpm ls failed while looking for missing deps; giving up and installing everything"
         echo "$OUTPUT"
+        restore_ws
         exec pnpm install
     fi
 
