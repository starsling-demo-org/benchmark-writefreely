diff --git a/scripts/ci-matrix-count.sh b/scripts/ci-matrix-count.sh
new file mode 100755
index 00000000..29a192ee
--- /dev/null
+++ b/scripts/ci-matrix-count.sh
@@ -0,0 +1,29 @@
+#!/bin/bash
+# Prints the number of packages `pnpm ls --depth -1 --parseable --filter '...@types/**[HEAD^1]'` would list,
+# for get-ci-matrix. Fast path: changed @types projects plus their dependents matched by NAME (every version
+# dir of a dependency name counts) is an upper bound on pnpm's set, read with git + jq only. When that bound
+# is <= 100 the shard count is provably pnpm's (1 shard) and pnpm is never started; above 100 the real pnpm
+# count is used, so fan-out PRs get exactly today's matrix.
+set -euo pipefail
+t=$(mktemp -d); trap 'rm -rf "$t"' EXIT
+git diff --name-only HEAD^1 -- types/ > "$t/changed"
+git ls-files -z -- ':(glob)types/**/package.json' | xargs -0 jq -c '{dir: (input_filename | sub("/package.json$"; "")), name: (.name // ""), deps: ([.dependencies, .devDependencies, .peerDependencies, .optionalDependencies] | map(select(type == "object") | to_entries[] | .key, ((.value | tostring | capture("^npm:(?<n>@?[^@]+)") | .n) // empty)) | unique)}' > "$t/projects"
+jq -rs --rawfile changed "$t/changed" '
+  (map({key: .dir, value: .}) | from_entries) as $by
+  | (reduce .[] as $p ({}; reduce ($p.deps[] | select(. != $p.name)) as $d (.; .[$d] += [$p.dir]))) as $rev
+  | [ $changed | split("\n")[] | select(length > 0) | split("/") as $s
+      | [ range(2; $s | length) | $s[0:.] | join("/") | select($by[.] != null) ] | last // empty ]
+  | unique | map(select($by[.].name | startswith("@types/"))) as $seed
+  | {sel: $seed, front: $seed}
+  | until((.front | length) == 0 or (.sel | length) > 100;
+      .sel as $sel
+      | ([ .front[] | $by[.].name | ($rev[.] // [])[] ] | unique | map(select(. as $d | ($sel | index($d)) == null))) as $new
+      | {sel: ($sel + $new), front: $new})
+  | .sel | sort[] ' "$t/projects" > "$t/sel"
+n=$(wc -l < "$t/sel")
+echo "name-closure upper bound: $n" >&2
+if [ "$n" -gt 100 ]; then
+  n=$(npx -y pnpm@10.30.1 ls --depth -1 --parseable --filter '...@types/**[HEAD^1]' | wc -l)
+  echo "pnpm count: $n" >&2
+fi
+echo "$n"
